# Email configuration for Gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# JWT Secret (at least 256 bits / 32 characters)
JWT_SECRET=mySecretKeyForJWTTokenGenerationAndValidation1234567890

# Optional: Override MySQL credentials
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_DATABASE=coffee_db
# MYSQL_USER=coffee_user
# MYSQL_PASSWORD=coffee_password
